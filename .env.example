OKX_PROFILE=demo
OKX_AUTH_MODE=api_key
OKX_LIVE_PROFILE=
OKX_DEMO_PROFILE=
OKX_CONNECTOR_MODE=mcp
OKX_MCP_COMMAND=okx-trade-mcp
# AURA enforces READ=market,account,spot --read-only and WRITE=spot.
ATK_CONTEXT_PULSE=false

UNIVERSE_SIZE=12
MIN_24H_QUOTE_VOLUME_USDT=10000000
UNIVERSE_REFRESH_MS=86400000

MAX_CONCURRENT_POSITIONS=3
MAX_TOTAL_EXPOSURE_PCT=0.25

LIVE_TRADING_ARMED=false

PRIMARY_BAR=3m
SLOW_LOOP_INTERVAL_MS=180000
FAST_LOOP_INTERVAL_MS=7000
MAX_RECONNECT_ATTEMPTS=3
MAX_HOLDING_MS=86400000
AURA_KILL_SWITCH=false
AURA_CONTROL_SOCKET_PATH=.aura/agent-control.sock
AURA_RECOVERY_STATE_PATH=.aura-recovery-state.json
AURA_AUDIT_PATH=.aura/audit.jsonl
AURA_STATUS_SNAPSHOT_PATH=.aura/status.json
AURA_DASHBOARD_PORT=8787
# Optional exact Host/Origin allowlist for a loopback tunnel; set in the launch shell for temporary use.
# AURA_DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1,example.ngrok-free.dev

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

LLM_TIMEOUT_MS=4500
LLM_MAX_OUTPUT_TOKENS=300
LLM_MAX_CALLS_PER_HOUR=25
LLM_MAX_CALLS_PER_DAY=250
LLM_MAX_DAILY_COST_USD=2.00
LLM_INPUT_USD_PER_MTOK=0.20
LLM_OUTPUT_USD_PER_MTOK=1.20

RISK_PER_TRADE_PCT=0.005
MAX_RISK_PER_TRADE_PCT=0.0075
MAX_POSITION_PCT=0.25
MIN_TRADE_NOTIONAL_USD=5

SOFT_DRAWDOWN_PCT=0.01
DEFENSIVE_DRAWDOWN_PCT=0.015
HARD_DAILY_LOSS_PCT=0.03
HARD_PEAK_DRAWDOWN_PCT=0.04

CONSECUTIVE_LOSS_PAUSE_MINUTES=20

MAX_DATA_AGE_MS=10000
MAX_SPREAD_BPS=
MAX_ATR_PERCENTILE=0.95

OPPORTUNITY_SCORE_THRESHOLD=65
MIN_EDGE_COST_RATIO=1.8

INITIAL_STOP_ATR_MULTIPLIER=1.5
BREAK_EVEN_TRIGGER_R=1.0
TRAILING_ACTIVATION_R=1.5
TAKE_PROFIT_R=2.5

# Human attestation: set true only after `npm run agent:attached-protection-smoke` PASSED on demo.
# false => live BUY entries impossible; protective SELL exits stay available.
LIVE_ENTRY_PROTECTION_VERIFIED=false
