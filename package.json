{
  "name": "aura",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "dev:web": "vite --config vite.config.ts",
    "agent:preflight": "tsx src/main.ts preflight",
    "agent:calibrate": "tsx src/main.ts calibrate",
    "agent:demo-smoke": "tsx src/main.ts demo-smoke",
    "agent:run": "tsx src/main.ts run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "dotenv": "^17.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
